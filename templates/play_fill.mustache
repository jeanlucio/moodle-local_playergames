{{!
    @template local_playergames/play_fill

    Daily PlayerFill game — crossword-style: guess each of the day's words, shared
    letters between words are revealed as other words are solved.

    Example context (json):
    {
        "sesskey": "abc123",
        "formaction": "/local/playergames/play_fill.php",
        "already_played": false,
        "no_concept": false,
        "revealed": false,
        "max_attempts": 4,
        "rows": [
            {
                "conceptid": 12,
                "definition": "A process converting light into sugar.",
                "tiles": [
                    {"letter": "", "revealed": false, "slotnum": "1"},
                    {"letter": "O", "revealed": true, "slotnum": ""}
                ],
                "resolved": false,
                "exhausted": false,
                "revealword": "",
                "canguess": true,
                "attemptsused": 0
            }
        ],
        "huburl": "/local/playergames/hub.php",
        "str_already_played": "You have already played PlayerFill today.",
        "str_no_concept": "No terms available.",
        "str_revealed_title": "Out of attempts",
        "str_revealed_msg": "You ran out of attempts on one of the words.",
        "str_definition_label": "Hint",
        "str_guess_label": "Your guess for this word",
        "str_submit": "Guess",
        "str_invalid": "That guess is not valid.",
        "str_solved": "Solved",
        "str_result_title": "Solved!",
        "str_result_xp": "XP earned:",
        "str_view_result": "View result",
        "str_back_to_hub": "Back to Hub"
    }
}}
<div class="local-playergames-play-fill pg-play-fill-wrap container py-4">

    {{#already_played}}
    <div class="alert alert-info" role="alert">
        <i class="fa fa-check-circle me-2" aria-hidden="true"></i>
        {{str_already_played}}
        <div class="mt-3">
            <a href="{{huburl}}" class="btn btn-primary btn-sm">{{str_back_to_hub}}</a>
        </div>
    </div>
    {{/already_played}}

    {{#no_concept}}
    <div class="alert alert-warning" role="alert">
        <i class="fa fa-exclamation-triangle me-2" aria-hidden="true"></i>
        {{str_no_concept}}
    </div>
    {{/no_concept}}

    {{#revealed}}
    <div class="alert alert-warning" role="alert">
        <i class="fa fa-circle-xmark me-2" aria-hidden="true"></i>
        <strong>{{str_revealed_title}}</strong>
        <div class="mt-1">{{str_revealed_msg}}</div>
        <div class="mt-3">
            <a href="{{huburl}}" class="btn btn-primary btn-sm">{{str_back_to_hub}}</a>
        </div>
    </div>
    {{/revealed}}

    {{^already_played}}{{^no_concept}}{{^revealed}}
    <div id="pg-fill-container"
         data-action="{{formaction}}"
         data-sesskey="{{sesskey}}"
         data-max-attempts="{{max_attempts}}"
         data-str-invalid="{{str_invalid}}">

        <div id="pg-fill-message" class="text-danger small mb-2" role="alert" aria-live="polite">&nbsp;</div>

        <div id="pg-fill-rows" class="pg-fill-rows">
            {{#rows}}
            <div class="pg-fill-row" data-conceptid="{{conceptid}}">
                <div class="pg-fill-tiles">
                    {{#tiles}}
                    <div class="pg-fill-tile{{#revealed}} pg-fill-tile-revealed{{/revealed}}">
                        {{#revealed}}{{letter}}{{/revealed}}
                        {{^revealed}}<span class="pg-fill-slotnum" aria-hidden="true">{{slotnum}}</span>{{/revealed}}
                    </div>
                    {{/tiles}}
                </div>

                <div class="pg-fill-clue">
                    <span class="pg-fill-definition">{{{definition}}}</span>
                    <span class="badge bg-success pg-fill-solved-badge{{^resolved}} d-none{{/resolved}}">
                        {{str_solved}}
                    </span>
                </div>

                <div class="pg-fill-guessform{{^canguess}} d-none{{/canguess}}">
                    <label class="visually-hidden" for="pg-fill-input-{{conceptid}}">{{str_guess_label}}</label>
                    <input type="text" id="pg-fill-input-{{conceptid}}" class="pg-fill-input form-control form-control-sm"
                           autocomplete="off" autocapitalize="characters">
                    <button type="button" class="pg-fill-submit btn btn-primary btn-sm">{{str_submit}}</button>
                </div>

                {{#revealword}}
                <div class="pg-fill-revealword text-muted small">{{revealword}}</div>
                {{/revealword}}
            </div>
            {{/rows}}
        </div>

        <div id="pg-fill-endactions" class="d-none text-center mt-4">
            <button type="button" id="pg-fill-view-result"
                    class="btn btn-outline-primary me-2">
                {{str_view_result}}
            </button>
            <a href="{{huburl}}" class="btn btn-primary">{{str_back_to_hub}}</a>
        </div>

        {{! Modal source blocks (hidden); the JS hoists their content into core/modal. }}
        <div id="pg-fill-result" class="d-none" data-title="{{str_result_title}}">
            <div class="text-center p-2">
                <i class="fa fa-star text-warning fa-2x mb-2" aria-hidden="true"></i>
                <p class="text-success fw-bold fs-4">
                    {{str_result_xp}} <span id="pg-fill-xp-count">…</span>
                </p>
                <a href="{{huburl}}" class="btn btn-primary mt-2">{{str_back_to_hub}}</a>
            </div>
        </div>

        <div id="pg-fill-failed" class="d-none" data-title="{{str_revealed_title}}">
            <div class="text-center p-2">
                <i class="fa fa-circle-xmark text-danger fa-2x mb-2" aria-hidden="true"></i>
                <p class="text-muted">{{str_revealed_msg}}</p>
                <a href="{{huburl}}" class="btn btn-primary mt-2">{{str_back_to_hub}}</a>
            </div>
        </div>

    </div>
    {{/revealed}}{{/no_concept}}{{/already_played}}

</div>
