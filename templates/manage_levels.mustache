{{!
    @template local_playergames/manage_levels

    Editable level ladder: minimum XP and title per level.

    Example context (json):
    {
        "formaction": "/local/playergames/manage_levels.php",
        "sesskey": "abc123",
        "str_intro": "Define how many levels exist.",
        "str_col_level": "Level",
        "str_col_minxp": "Minimum XP",
        "str_col_title": "Title",
        "str_add_heading": "Add levels",
        "str_add_hint": "Fill in a title to add a new level.",
        "str_save": "Save changes",
        "str_restore": "Restore defaults",
        "rows": [
            {"index": 0, "level": 1, "minxp": 0, "title": "Novice", "islevelone": true, "isblank": false},
            {"index": 1, "level": 2, "minxp": 100, "title": "Apprentice", "islevelone": false, "isblank": false},
            {"index": 2, "isblank": true}
        ]
    }
}}
<div class="local-playergames-levels">

    <p class="text-muted">{{str_intro}}</p>

    <form method="post" action="{{formaction}}">
        <input type="hidden" name="sesskey" value="{{sesskey}}">

        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th scope="col" class="pg-levels-num-col">{{str_col_level}}</th>
                    <th scope="col" class="pg-levels-xp-col">{{str_col_minxp}}</th>
                    <th scope="col">{{str_col_title}}</th>
                </tr>
            </thead>
            <tbody>
                {{#rows}}
                <tr>
                    {{^isblank}}
                    <th scope="row">{{level}}</th>
                    <td>
                        <input type="number" min="0" class="form-control"
                               name="minxp[{{index}}]" value="{{minxp}}"
                               {{#islevelone}}readonly{{/islevelone}}
                               aria-label="{{str_col_minxp}} {{level}}">
                    </td>
                    <td>
                        <input type="text" maxlength="100" class="form-control"
                               name="title[{{index}}]" value="{{title}}"
                               aria-label="{{str_col_title}} {{level}}">
                    </td>
                    {{/isblank}}
                    {{#isblank}}
                    <th scope="row" class="text-muted">+</th>
                    <td>
                        <input type="number" min="0" class="form-control"
                               name="minxp[{{index}}]" value=""
                               aria-label="{{str_col_minxp}}">
                    </td>
                    <td>
                        <input type="text" maxlength="100" class="form-control"
                               name="title[{{index}}]" value=""
                               aria-label="{{str_col_title}}">
                    </td>
                    {{/isblank}}
                </tr>
                {{/rows}}
            </tbody>
        </table>

        <p class="fw-semibold mb-1">{{str_add_heading}}</p>
        <p class="text-muted small">{{str_add_hint}}</p>

        <button type="submit" class="btn btn-primary">
            <i class="fa fa-save me-1" aria-hidden="true"></i>
            {{str_save}}
        </button>
    </form>

    <form method="post" action="{{formaction}}" class="mt-2">
        <input type="hidden" name="sesskey" value="{{sesskey}}">
        <input type="hidden" name="action" value="restore">
        <button type="submit" class="btn btn-outline-secondary">{{str_restore}}</button>
    </form>

</div>
