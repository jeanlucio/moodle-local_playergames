{{!
    @template local_playergames/hall_of_fame

    @package local_playergames
    @copyright 2026 Jean Lúcio
    @license https://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later

    Example context (json):
    {
        "str_pagetitle": "Hall of fame",
        "str_intro": "The top 10 of each closed season.",
        "str_empty": "No season has closed with a visible ranking yet.",
        "str_students": "Students",
        "str_staff": "Staff",
        "str_rank_pos": "#",
        "str_rank_player": "Player",
        "str_rank_xp": "XP",
        "str_rank_level": "Level",
        "str_you": "You",
        "hasseasons": true,
        "seasons": [
            {
                "name": "Season 1",
                "hasstudents": true,
                "hasstaff": false,
                "bothgroups": false,
                "students": [
                    {"position": 1, "name": "Ada Lovelace", "xp": 385, "level": 7, "isself": true}
                ],
                "staff": []
            }
        ]
    }
}}
<div class="pg-hall">
    <h2>{{str_pagetitle}}</h2>
    <p>{{str_intro}}</p>

    {{^hasseasons}}
    <p>{{str_empty}}</p>
    {{/hasseasons}}

    {{#seasons}}
    <section class="card mb-4">
        <div class="card-header">
            <h3 class="h5 mb-0">{{name}}</h3>
        </div>
        <div class="card-body">
            {{#hasstudents}}
            {{#bothgroups}}<h4 class="h6 mt-3 mb-2">{{str_students}}</h4>{{/bothgroups}}
            <div class="table-responsive">
                <table class="table table-hover pg-hall-table">
                    <thead class="table-light">
                        <tr>
                            <th scope="col" class="text-center pg-hall-col-pos">{{str_rank_pos}}</th>
                            <th scope="col">{{str_rank_player}}</th>
                            <th scope="col" class="text-end pg-hall-col-num">{{str_rank_xp}}</th>
                            <th scope="col" class="text-center pg-hall-col-num">{{str_rank_level}}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#students}}
                        <tr class="{{#isself}}table-primary{{/isself}}">
                            <td class="text-center fw-bold">{{position}}</td>
                            <td>{{name}}{{#isself}} <span class="badge bg-primary">{{str_you}}</span>{{/isself}}</td>
                            <td class="text-end">{{xp}}</td>
                            <td class="text-center"><span class="badge bg-primary">{{level}}</span></td>
                        </tr>
                        {{/students}}
                    </tbody>
                </table>
            </div>
            {{/hasstudents}}

            {{#hasstaff}}
            {{#bothgroups}}<h4 class="h6 mt-3 mb-2">{{str_staff}}</h4>{{/bothgroups}}
            <div class="table-responsive">
                <table class="table table-hover pg-hall-table">
                    <thead class="table-light">
                        <tr>
                            <th scope="col" class="text-center pg-hall-col-pos">{{str_rank_pos}}</th>
                            <th scope="col">{{str_rank_player}}</th>
                            <th scope="col" class="text-end pg-hall-col-num">{{str_rank_xp}}</th>
                            <th scope="col" class="text-center pg-hall-col-num">{{str_rank_level}}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#staff}}
                        <tr class="{{#isself}}table-primary{{/isself}}">
                            <td class="text-center fw-bold">{{position}}</td>
                            <td>{{name}}{{#isself}} <span class="badge bg-primary">{{str_you}}</span>{{/isself}}</td>
                            <td class="text-end">{{xp}}</td>
                            <td class="text-center"><span class="badge bg-primary">{{level}}</span></td>
                        </tr>
                        {{/staff}}
                    </tbody>
                </table>
            </div>
            {{/hasstaff}}
        </div>
    </section>
    {{/seasons}}
</div>
