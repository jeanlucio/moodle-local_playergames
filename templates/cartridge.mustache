{{!
    @template local_playergames/cartridge

    Shell layout for the concept cartridge management page.
    Follows the PlayerHUD manage_layout pattern: header + server-side nav tabs + content area.

    Example context (json):
    {
        "heading": "Concept cartridges",
        "editing": false,
        "tabs": [
            { "active": true,  "url": "/local/playergames/cartridge.php?tab=library", "text": "Library",    "icon": "<i class='fa fa-list' aria-hidden='true'></i>" },
            { "active": false, "url": "/local/playergames/cartridge.php?tab=create",  "text": "Create cartridge", "icon": "<i class='fa fa-plus-circle' aria-hidden='true'></i>" },
            { "active": false, "url": "/local/playergames/cartridge.php?tab=ai",      "text": "Generate with AI", "icon": "<i class='fa fa-magic' aria-hidden='true'></i>" },
            { "active": false, "url": "/local/playergames/cartridge.php?tab=import",  "text": "Import JSON", "icon": "<i class='fa fa-upload' aria-hidden='true'></i>" }
        ],
        "content_html": "<p>Tab content rendered server-side.</p>"
    }
}}

<div class="local-playergames-cartridge container-fluid p-0 animate__animated animate__fadeIn">

    {{! ── Header ── }}
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <h2 class="m-0">{{heading}}</h2>
        <div class="d-flex"></div>
    </div>

    {{! ── Navigation tabs (server-side GET) — hidden while editing a cartridge ── }}
    {{^editing}}
    <ul class="nav nav-tabs mb-4" id="pg-cartridge-tabs">
        {{#tabs}}
        <li class="nav-item">
            <a class="nav-link{{#active}} active{{/active}}" href="{{url}}">
                <span aria-hidden="true" class="me-2">{{{icon}}}</span>{{text}}
            </a>
        </li>
        {{/tabs}}
    </ul>
    {{/editing}}

    {{! ── Tab content (rendered server-side) ── }}
    <div class="pg-cartridge-content">
        {{{content_html}}}
    </div>

</div>{{! .local-playergames-cartridge }}
