{{!
    @template local_playergames/cartridge

    Concept cartridge management page with import, AI generation, and manual editor.

    Example context (json):
    {
        "pagetitle": "Manage concept cartridges",
        "heading": "Concept cartridges",
        "action_url": "/local/playergames/cartridge.php",
        "sesskey": "abc123",
        "cartridges": [
            {
                "id": 1,
                "name": "Gamification Fundamentals",
                "language": "en",
                "version": "1.0",
                "concepts_count": 42,
                "is_active": true,
                "is_inactive": false,
                "uploaded_date": "27 Apr 2026, 10:00",
                "uploadedby_fullname": "Admin User",
                "edit_url": "/local/playergames/cartridge.php?tab=editor&cartridgeid=1",
                "export_url": "/local/playergames/cartridge.php?action=export_cartridge&cartridgeid=1",
                "sesskey": "abc123"
            }
        ],
        "cartridges_empty": false,
        "tab_import_active": true,
        "tab_ai_active": false,
        "tab_editor_active": false,
        "has_ai_key": true,
        "has_ai_preview": false,
        "ai_preview": null,
        "ai_form_topic": "",
        "ai_form_language": "",
        "ai_form_quantity": 20,
        "ai_form_difficulty": 3,
        "ai_error": "",
        "has_ai_error": false,
        "editor_cartridge_id": 0,
        "editor_cartridge_name": "",
        "has_editor_cartridge": false,
        "concepts": [],
        "concepts_empty": true,
        "form_action": "add_concept",
        "form_concept_id": 0,
        "form_term": "",
        "form_definition": "",
        "form_category": "",
        "form_difficulty": 3,
        "editing_concept": false
    }
}}

<div class="local-playergames-cartridge">

    {{! ── Cartridge list ── }}
    <h3>{{heading}}</h3>

    {{#cartridges_empty}}
    <p class="text-muted pg-cartridge-empty">{{#str}}cartridge_list_empty, local_playergames{{/str}}</p>
    {{/cartridges_empty}}

    {{^cartridges_empty}}
    <div class="table-responsive">
        <table class="table table-striped table-hover pg-cartridge-table">
            <thead>
                <tr>
                    <th scope="col">{{#str}}cartridge_name, local_playergames{{/str}}</th>
                    <th scope="col">{{#str}}cartridge_language, local_playergames{{/str}}</th>
                    <th scope="col">{{#str}}cartridge_concepts_count, local_playergames{{/str}}</th>
                    <th scope="col">{{#str}}cartridge_uploaded, local_playergames{{/str}}</th>
                    <th scope="col">{{#str}}cartridge_uploadedby, local_playergames{{/str}}</th>
                    <th scope="col"></th>
                </tr>
            </thead>
            <tbody>
                {{#cartridges}}
                <tr>
                    <td>
                        {{name}}
                        {{#is_active}}
                        <span class="badge bg-success ms-1">{{#str}}cartridge_active, local_playergames{{/str}}</span>
                        {{/is_active}}
                        {{#is_inactive}}
                        <span class="badge bg-secondary ms-1">{{#str}}cartridge_inactive, local_playergames{{/str}}</span>
                        {{/is_inactive}}
                    </td>
                    <td>{{language}}</td>
                    <td>{{concepts_count}}</td>
                    <td>{{uploaded_date}}</td>
                    <td>{{uploadedby_fullname}}</td>
                    <td class="pg-cartridge-actions">
                        <a href="{{edit_url}}" class="btn btn-sm btn-outline-secondary me-1">
                            {{#str}}cartridge_edit_concepts, local_playergames{{/str}}
                        </a>
                        <a href="{{export_url}}" class="btn btn-sm btn-outline-secondary me-1">
                            {{#str}}cartridge_export, local_playergames{{/str}}
                        </a>
                        <form method="post" action="{{action_url}}" class="d-inline">
                            <input type="hidden" name="sesskey" value="{{sesskey}}">
                            <input type="hidden" name="action" value="toggle_active">
                            <input type="hidden" name="cartridgeid" value="{{id}}">
                            {{#is_active}}
                            <button type="submit" class="btn btn-sm btn-outline-warning me-1">
                                {{#str}}cartridge_deactivate, local_playergames{{/str}}
                            </button>
                            {{/is_active}}
                            {{#is_inactive}}
                            <button type="submit" class="btn btn-sm btn-outline-success me-1">
                                {{#str}}cartridge_activate, local_playergames{{/str}}
                            </button>
                            {{/is_inactive}}
                        </form>
                        <form method="post" action="{{action_url}}" class="d-inline"
                              data-pg-confirm="{{#str}}cartridge_confirm_delete, local_playergames{{/str}}">
                            <input type="hidden" name="sesskey" value="{{sesskey}}">
                            <input type="hidden" name="action" value="delete_cartridge">
                            <input type="hidden" name="cartridgeid" value="{{id}}">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                {{#str}}cartridge_delete, local_playergames{{/str}}
                            </button>
                        </form>
                    </td>
                </tr>
                {{/cartridges}}
            </tbody>
        </table>
    </div>
    {{/cartridges_empty}}

    {{! ── Create / manage tabs ── }}
    <div class="card mt-4">
        <div class="card-header p-0">
            <ul class="nav nav-tabs card-header-tabs ps-3" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link{{#tab_import_active}} active{{/tab_import_active}}"
                            data-bs-toggle="tab" data-bs-target="#pg-tab-import"
                            type="button" role="tab">
                        {{#str}}cartridge_tab_import, local_playergames{{/str}}
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link{{#tab_ai_active}} active{{/tab_ai_active}}"
                            data-bs-toggle="tab" data-bs-target="#pg-tab-ai"
                            type="button" role="tab">
                        {{#str}}cartridge_tab_ai, local_playergames{{/str}}
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link{{#tab_editor_active}} active{{/tab_editor_active}}"
                            data-bs-toggle="tab" data-bs-target="#pg-tab-editor"
                            type="button" role="tab">
                        {{#str}}cartridge_tab_editor, local_playergames{{/str}}
                    </button>
                </li>
            </ul>
        </div>

        <div class="card-body">
            <div class="tab-content">

                {{! ── Tab 1: Import JSON ── }}
                <div class="tab-pane fade{{#tab_import_active}} show active{{/tab_import_active}}"
                     id="pg-tab-import" role="tabpanel">
                    <h4 class="mt-2">{{#str}}cartridge_import_heading, local_playergames{{/str}}</h4>
                    <form method="post" action="{{action_url}}" enctype="multipart/form-data">
                        <input type="hidden" name="sesskey" value="{{sesskey}}">
                        <input type="hidden" name="action" value="import_json">
                        <div class="mb-3">
                            <label for="pg-import-file" class="form-label">
                                {{#str}}cartridge_import_file, local_playergames{{/str}}
                            </label>
                            <input type="file" id="pg-import-file" name="jsonfile"
                                   accept=".json,application/json" class="form-control" required>
                        </div>
                        <button type="submit" class="btn btn-primary">
                            {{#str}}cartridge_tab_import, local_playergames{{/str}}
                        </button>
                    </form>
                </div>

                {{! ── Tab 2: Generate with AI ── }}
                <div class="tab-pane fade{{#tab_ai_active}} show active{{/tab_ai_active}}"
                     id="pg-tab-ai" role="tabpanel">
                    <h4 class="mt-2">{{#str}}cartridge_ai_heading, local_playergames{{/str}}</h4>

                    {{^has_ai_key}}
                    <div class="alert alert-warning" role="alert">
                        {{#str}}cartridge_ai_nokey, local_playergames{{/str}}
                    </div>
                    {{/has_ai_key}}

                    {{#has_ai_key}}
                    <form method="post" action="{{action_url}}">
                        <input type="hidden" name="sesskey" value="{{sesskey}}">
                        <input type="hidden" name="action" value="generate_ai">
                        <div class="row g-3">
                            <div class="col-12">
                                <label for="pg-ai-topic" class="form-label">
                                    {{#str}}cartridge_ai_topic, local_playergames{{/str}}
                                </label>
                                <input type="text" id="pg-ai-topic" name="topic"
                                       value="{{ai_form_topic}}" class="form-control" required
                                       placeholder="{{#str}}cartridge_ai_topic_desc, local_playergames{{/str}}">
                            </div>
                            <div class="col-md-4">
                                <label for="pg-ai-language" class="form-label">
                                    {{#str}}cartridge_ai_language, local_playergames{{/str}}
                                </label>
                                <input type="text" id="pg-ai-language" name="ai_language"
                                       value="{{ai_form_language}}" class="form-control"
                                       placeholder="English">
                            </div>
                            <div class="col-md-4">
                                <label for="pg-ai-quantity" class="form-label">
                                    {{#str}}cartridge_ai_quantity, local_playergames{{/str}}
                                </label>
                                <input type="number" id="pg-ai-quantity" name="quantity"
                                       value="{{ai_form_quantity}}" min="10" max="100"
                                       class="form-control">
                            </div>
                            <div class="col-md-4">
                                <label for="pg-ai-difficulty" class="form-label">
                                    {{#str}}cartridge_ai_difficulty, local_playergames{{/str}}
                                </label>
                                <input type="number" id="pg-ai-difficulty" name="difficulty"
                                       value="{{ai_form_difficulty}}" min="1" max="5"
                                       class="form-control">
                            </div>
                        </div>
                        <div class="mt-3">
                            <button type="submit" class="btn btn-primary">
                                {{#str}}cartridge_ai_generate, local_playergames{{/str}}
                            </button>
                        </div>
                    </form>
                    {{/has_ai_key}}

                    {{#has_ai_error}}
                    <div class="alert alert-danger mt-3" role="alert">{{ai_error}}</div>
                    {{/has_ai_error}}

                    {{#has_ai_preview}}
                    <hr>
                    <h5>{{#str}}cartridge_preview_heading, local_playergames{{/str}}</h5>
                    <form method="post" action="{{action_url}}">
                        <input type="hidden" name="sesskey" value="{{sesskey}}">
                        <input type="hidden" name="action" value="save_ai_cartridge">
                        <div class="row g-2 mb-3">
                            <div class="col-md-6">
                                <label for="pg-ai-name" class="form-label">
                                    {{#str}}cartridge_name, local_playergames{{/str}}
                                </label>
                                <input type="text" id="pg-ai-name" name="ai_cartridge_name"
                                       value="{{ai_preview.cartridge_name}}" class="form-control" required>
                            </div>
                            <div class="col-md-3">
                                <label for="pg-ai-savelang" class="form-label">
                                    {{#str}}cartridge_language, local_playergames{{/str}}
                                </label>
                                <input type="text" id="pg-ai-savelang" name="ai_language"
                                       value="{{ai_preview.language}}" class="form-control">
                            </div>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-sm pg-preview-table">
                                <thead>
                                    <tr>
                                        <th scope="col">{{#str}}concept_term, local_playergames{{/str}}</th>
                                        <th scope="col">{{#str}}concept_definition, local_playergames{{/str}}</th>
                                        <th scope="col">{{#str}}concept_category, local_playergames{{/str}}</th>
                                        <th scope="col">{{#str}}concept_difficulty, local_playergames{{/str}}</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {{#ai_preview.concepts}}
                                    <tr>
                                        <td>
                                            <input type="text"
                                                   name="concepts[{{index}}][term]"
                                                   value="{{term}}"
                                                   class="form-control form-control-sm">
                                        </td>
                                        <td>
                                            <input type="text"
                                                   name="concepts[{{index}}][definition]"
                                                   value="{{definition}}"
                                                   class="form-control form-control-sm">
                                        </td>
                                        <td>
                                            <input type="text"
                                                   name="concepts[{{index}}][category]"
                                                   value="{{category}}"
                                                   class="form-control form-control-sm pg-category-input">
                                        </td>
                                        <td>
                                            <input type="number"
                                                   name="concepts[{{index}}][difficulty]"
                                                   value="{{difficulty}}"
                                                   min="1" max="5"
                                                   class="form-control form-control-sm pg-difficulty-input">
                                        </td>
                                    </tr>
                                    {{/ai_preview.concepts}}
                                </tbody>
                            </table>
                        </div>
                        <button type="submit" class="btn btn-success">
                            {{#str}}cartridge_preview_save, local_playergames{{/str}}
                        </button>
                    </form>
                    {{/has_ai_preview}}
                </div>

                {{! ── Tab 3: Manual editor ── }}
                <div class="tab-pane fade{{#tab_editor_active}} show active{{/tab_editor_active}}"
                     id="pg-tab-editor" role="tabpanel">

                    {{^has_editor_cartridge}}
                    <p class="text-muted mt-2">
                        {{#str}}cartridge_select_to_edit, local_playergames{{/str}}
                    </p>
                    <hr>
                    <h5>{{#str}}cartridge_new_heading, local_playergames{{/str}}</h5>
                    <form method="post" action="{{action_url}}" class="row g-2 align-items-end">
                        <input type="hidden" name="sesskey" value="{{sesskey}}">
                        <input type="hidden" name="action" value="create_cartridge">
                        <div class="col-md-5">
                            <label for="pg-new-name" class="form-label">
                                {{#str}}cartridge_name, local_playergames{{/str}}
                            </label>
                            <input type="text" id="pg-new-name" name="cartridge_name"
                                   class="form-control" required>
                        </div>
                        <div class="col-md-3">
                            <label for="pg-new-lang" class="form-label">
                                {{#str}}cartridge_language, local_playergames{{/str}}
                            </label>
                            <input type="text" id="pg-new-lang" name="cartridge_language"
                                   class="form-control" placeholder="pt_BR">
                        </div>
                        <div class="col-auto">
                            <button type="submit" class="btn btn-primary">
                                {{#str}}cartridge_new_create, local_playergames{{/str}}
                            </button>
                        </div>
                    </form>
                    {{/has_editor_cartridge}}

                    {{#has_editor_cartridge}}
                    <div class="d-flex align-items-center justify-content-between mt-2 mb-3">
                        <h4 class="mb-0">{{editor_cartridge_name}}</h4>
                        <a href="#" id="pg-export-editor"
                           data-cartridgeid="{{editor_cartridge_id}}"
                           class="btn btn-outline-secondary btn-sm">
                            {{#str}}cartridge_export, local_playergames{{/str}}
                        </a>
                    </div>

                    {{! Add / edit concept form }}
                    <div class="card mb-4">
                        <div class="card-body">
                            <h6 class="card-title">
                                {{#editing_concept}}
                                {{#str}}concept_edit, local_playergames{{/str}}
                                {{/editing_concept}}
                                {{^editing_concept}}
                                {{#str}}cartridge_add_concept, local_playergames{{/str}}
                                {{/editing_concept}}
                            </h6>
                            <form method="post" action="{{action_url}}">
                                <input type="hidden" name="sesskey" value="{{sesskey}}">
                                <input type="hidden" name="action" value="{{form_action}}">
                                <input type="hidden" name="cartridgeid" value="{{editor_cartridge_id}}">
                                {{#editing_concept}}
                                <input type="hidden" name="concept_id" value="{{form_concept_id}}">
                                {{/editing_concept}}
                                <div class="row g-2">
                                    <div class="col-md-3">
                                        <label for="pg-form-term" class="form-label">
                                            {{#str}}concept_term, local_playergames{{/str}}
                                        </label>
                                        <input type="text" id="pg-form-term" name="term"
                                               value="{{form_term}}" class="form-control" required>
                                    </div>
                                    <div class="col-md-5">
                                        <label for="pg-form-def" class="form-label">
                                            {{#str}}concept_definition, local_playergames{{/str}}
                                        </label>
                                        <input type="text" id="pg-form-def" name="definition"
                                               value="{{form_definition}}" class="form-control" required>
                                    </div>
                                    <div class="col-md-2">
                                        <label for="pg-form-cat" class="form-label">
                                            {{#str}}concept_category, local_playergames{{/str}}
                                        </label>
                                        <input type="text" id="pg-form-cat" name="category"
                                               value="{{form_category}}" class="form-control">
                                    </div>
                                    <div class="col-md-2">
                                        <label for="pg-form-diff" class="form-label">
                                            {{#str}}concept_difficulty, local_playergames{{/str}}
                                        </label>
                                        <input type="number" id="pg-form-diff" name="difficulty"
                                               value="{{form_difficulty}}" min="1" max="5"
                                               class="form-control">
                                    </div>
                                </div>
                                <div class="mt-2">
                                    <button type="submit" class="btn btn-primary btn-sm">
                                        {{#str}}concept_saved, local_playergames{{/str}}
                                    </button>
                                    {{#editing_concept}}
                                    <a href="{{action_url}}?tab=editor&cartridgeid={{editor_cartridge_id}}"
                                       class="btn btn-outline-secondary btn-sm ms-1">
                                        {{#str}}moodle, cancel{{/str}}
                                    </a>
                                    {{/editing_concept}}
                                </div>
                            </form>
                        </div>
                    </div>

                    {{! Concept list }}
                    {{#concepts_empty}}
                    <p class="text-muted">
                        {{#str}}concept_list_empty, local_playergames{{/str}}
                    </p>
                    {{/concepts_empty}}

                    {{^concepts_empty}}
                    <div class="table-responsive">
                        <table class="table table-sm pg-concept-table">
                            <thead>
                                <tr>
                                    <th scope="col">{{#str}}concept_term, local_playergames{{/str}}</th>
                                    <th scope="col">{{#str}}concept_definition, local_playergames{{/str}}</th>
                                    <th scope="col">{{#str}}concept_category, local_playergames{{/str}}</th>
                                    <th scope="col">{{#str}}concept_difficulty, local_playergames{{/str}}</th>
                                    <th scope="col"></th>
                                </tr>
                            </thead>
                            <tbody>
                                {{#concepts}}
                                <tr>
                                    <td>{{term}}</td>
                                    <td>{{definition}}</td>
                                    <td>{{category}}</td>
                                    <td>{{difficulty}}</td>
                                    <td class="pg-concept-actions">
                                        <a href="{{edit_url}}" class="btn btn-sm btn-outline-secondary me-1">
                                            {{#str}}concept_edit, local_playergames{{/str}}
                                        </a>
                                        <form method="post" action="{{action_url}}" class="d-inline"
                                              data-pg-confirm="{{#str}}cartridge_confirm_delete, local_playergames{{/str}}">
                                            <input type="hidden" name="sesskey" value="{{sesskey}}">
                                            <input type="hidden" name="action" value="delete_concept">
                                            <input type="hidden" name="cartridgeid" value="{{cartridgeid}}">
                                            <input type="hidden" name="concept_id" value="{{id}}">
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                {{#str}}concept_delete, local_playergames{{/str}}
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                                {{/concepts}}
                            </tbody>
                        </table>
                    </div>
                    {{/concepts_empty}}

                    {{/has_editor_cartridge}}
                </div>

            </div>{{! .tab-content }}
        </div>{{! .card-body }}
    </div>{{! .card }}

</div>{{! .local-playergames-cartridge }}
