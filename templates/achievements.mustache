{{!
    @template local_playergames/achievements

    Grid of all achievements with earned/locked state.

    Example context (json):
    {
        "str_pagetitle": "Achievements",
        "str_huburl": "/local/playergames/hub.php",
        "totalearned": 2,
        "total": 6,
        "items": [
            {
                "icon": "fa-gamepad",
                "name": "First Steps",
                "desc": "Complete your first daily game.",
                "earned": true,
                "locked": false,
                "earnedts": "1 June 2026"
            },
            {
                "icon": "fa-medal",
                "name": "Century Player",
                "desc": "Complete 100 daily games in a season.",
                "earned": false,
                "locked": true,
                "earnedts": ""
            }
        ]
    }
}}
<div class="path-local-playergames pg-achievements">

    <div class="mb-4">
        <span class="badge bg-warning text-dark">
            {{totalearned}}/{{total}}
        </span>
    </div>

    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        {{#items}}
        <div class="col">
            <div class="card h-100 pg-achievement-card {{#locked}}pg-achievement-locked{{/locked}}">
                <div class="card-body text-center p-4">
                    <div class="pg-achievement-icon mb-3">
                        <i class="fa {{icon}} fa-2x
                            {{#earned}}text-warning{{/earned}}
                            {{#locked}}text-muted{{/locked}}"
                            role="img" aria-label="{{name}}"></i>
                    </div>
                    <h6 class="card-title {{#locked}}text-muted{{/locked}}">{{name}}</h6>
                    <p class="card-text small text-muted mb-2">{{desc}}</p>
                    {{#earned}}
                    <span class="badge bg-success">
                        <i class="fa fa-check me-1" aria-hidden="true"></i>{{earnedts}}
                    </span>
                    {{/earned}}
                    {{#locked}}
                    <span class="badge bg-secondary">
                        <i class="fa fa-lock me-1" aria-hidden="true"></i>
                    </span>
                    {{/locked}}
                </div>
            </div>
        </div>
        {{/items}}
    </div>

</div>{{! end pg-achievements }}
