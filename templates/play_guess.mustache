{{!
    @template local_playergames/play_guess

    Daily PlayerGuess game — Wordle-style: guess the term letter by letter.

    Example context (json):
    {
        "sesskey": "abc123",
        "formaction": "/local/playergames/play_guess.php",
        "already_played": false,
        "no_concept": false,
        "revealed": false,
        "definition": "A process converting light into sugar.",
        "target_length": 6,
        "max_attempts": 6,
        "rows_json": "[]",
        "huburl": "/local/playergames/hub.php",
        "str_already_played": "You have already played PlayerGuess today.",
        "str_no_concept": "No terms available.",
        "str_revealed_title": "Out of attempts",
        "str_revealed_msg": "You ran out of attempts. The term was: photosynthesis",
        "str_definition_label": "Hint",
        "str_enter": "Enter",
        "str_backspace": "Backspace",
        "str_invalid": "That guess is not valid.",
        "str_result_title": "Correct!",
        "str_result_xp": "XP earned:",
        "str_view_result": "View result",
        "str_back_to_hub": "Back to Hub"
    }
}}
<div class="local-playergames-play-guess pg-play-guess-wrap container py-4">

    {{#already_played}}
    <div class="alert alert-info" role="alert">
        <i class="fa fa-check-circle me-2" aria-hidden="true"></i>
        {{str_already_played}}
        <div class="mt-3">
            <a href="{{huburl}}" class="btn btn-primary btn-sm">{{str_back_to_hub}}</a>
        </div>
    </div>
    {{/already_played}}

    {{#no_concept}}
    <div class="alert alert-warning" role="alert">
        <i class="fa fa-exclamation-triangle me-2" aria-hidden="true"></i>
        {{str_no_concept}}
    </div>
    {{/no_concept}}

    {{#revealed}}
    <div class="alert alert-warning" role="alert">
        <i class="fa fa-circle-xmark me-2" aria-hidden="true"></i>
        <strong>{{str_revealed_title}}</strong>
        <div class="mt-1">{{str_revealed_msg}}</div>
        <div class="mt-3">
            <a href="{{huburl}}" class="btn btn-primary btn-sm">{{str_back_to_hub}}</a>
        </div>
    </div>
    {{/revealed}}

    {{^already_played}}{{^no_concept}}{{^revealed}}
    <div id="pg-guess-container"
         data-action="{{formaction}}"
         data-sesskey="{{sesskey}}"
         data-target-length="{{target_length}}"
         data-max-attempts="{{max_attempts}}"
         data-rows="{{rows_json}}"
         data-str-invalid="{{str_invalid}}">

        {{#definition}}
        <div class="alert alert-info pg-guess-hint" role="note">
            <strong>{{str_definition_label}}:</strong> {{{definition}}}
        </div>
        {{/definition}}

        <div id="pg-guess-message" class="text-danger small mb-2" role="alert" aria-live="polite">&nbsp;</div>

        <div id="pg-guess-board" class="pg-guess-board mb-4"></div>

        <div id="pg-guess-keyboard" class="pg-guess-keyboard" role="group" aria-label="{{str_enter}}">
            <div class="pg-guess-kbrow">
                <button type="button" class="pg-guess-key" data-key="Q">Q</button>
                <button type="button" class="pg-guess-key" data-key="W">W</button>
                <button type="button" class="pg-guess-key" data-key="E">E</button>
                <button type="button" class="pg-guess-key" data-key="R">R</button>
                <button type="button" class="pg-guess-key" data-key="T">T</button>
                <button type="button" class="pg-guess-key" data-key="Y">Y</button>
                <button type="button" class="pg-guess-key" data-key="U">U</button>
                <button type="button" class="pg-guess-key" data-key="I">I</button>
                <button type="button" class="pg-guess-key" data-key="O">O</button>
                <button type="button" class="pg-guess-key" data-key="P">P</button>
            </div>
            <div class="pg-guess-kbrow">
                <button type="button" class="pg-guess-key" data-key="A">A</button>
                <button type="button" class="pg-guess-key" data-key="S">S</button>
                <button type="button" class="pg-guess-key" data-key="D">D</button>
                <button type="button" class="pg-guess-key" data-key="F">F</button>
                <button type="button" class="pg-guess-key" data-key="G">G</button>
                <button type="button" class="pg-guess-key" data-key="H">H</button>
                <button type="button" class="pg-guess-key" data-key="J">J</button>
                <button type="button" class="pg-guess-key" data-key="K">K</button>
                <button type="button" class="pg-guess-key" data-key="L">L</button>
            </div>
            <div class="pg-guess-kbrow">
                <button type="button" class="pg-guess-key pg-guess-key-wide" data-key="ENTER"
                        aria-label="{{str_enter}}">{{str_enter}}</button>
                <button type="button" class="pg-guess-key" data-key="Z">Z</button>
                <button type="button" class="pg-guess-key" data-key="X">X</button>
                <button type="button" class="pg-guess-key" data-key="C">C</button>
                <button type="button" class="pg-guess-key" data-key="V">V</button>
                <button type="button" class="pg-guess-key" data-key="B">B</button>
                <button type="button" class="pg-guess-key" data-key="N">N</button>
                <button type="button" class="pg-guess-key" data-key="M">M</button>
                <button type="button" class="pg-guess-key pg-guess-key-wide" data-key="BACKSPACE"
                        aria-label="{{str_backspace}}">
                    <i class="fa fa-delete-left" aria-hidden="true"></i>
                </button>
            </div>
        </div>

        <div id="pg-guess-endactions" class="d-none text-center mt-4">
            <button type="button" id="pg-guess-view-result"
                    class="btn btn-outline-primary me-2">
                {{str_view_result}}
            </button>
            <a href="{{huburl}}" class="btn btn-primary">{{str_back_to_hub}}</a>
        </div>

        {{! Modal source blocks (hidden); the JS hoists their content into core/modal. }}
        <div id="pg-guess-result" class="d-none" data-title="{{str_result_title}}">
            <div class="text-center p-2">
                <i class="fa fa-star text-warning fa-2x mb-2" aria-hidden="true"></i>
                <p class="text-success fw-bold fs-4">
                    {{str_result_xp}} <span id="pg-guess-xp-count">…</span>
                </p>
                <a href="{{huburl}}" class="btn btn-primary mt-2">{{str_back_to_hub}}</a>
            </div>
        </div>

        <div id="pg-guess-failed" class="d-none" data-title="{{str_revealed_title}}">
            <div class="text-center p-2">
                <i class="fa fa-circle-xmark text-danger fa-2x mb-2" aria-hidden="true"></i>
                <p class="text-muted" id="pg-guess-failed-msg">&nbsp;</p>
                <a href="{{huburl}}" class="btn btn-primary mt-2">{{str_back_to_hub}}</a>
            </div>
        </div>

    </div>
    {{/revealed}}{{/no_concept}}{{/already_played}}

</div>
