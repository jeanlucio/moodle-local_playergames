{{!
    @template local_playergames/administration

    The Administration tab: cards grouped in the order an administrator sets things up, each group in its own colour.
    Each card is a link to the page of the function, opened in another tab so the list stays at hand, with what the
    function does and, where there is one, where things stand.

    Example context (json):
    {
        "str_title": "Administration",
        "str_intro": "What an administrator sets up, in the order it is usually done.",
        "groups": [
            {
                "key": "start",
                "title": "Get started",
                "cards": [
                    {
                        "key": "seasons",
                        "name": "Seasons",
                        "description": "The period in which students earn XP.",
                        "url": "/local/playergames/manage_seasons.php",
                        "state": "Active: Season 1",
                        "hasstate": true,
                        "icon": "fa-calendar-days"
                    },
                    {
                        "key": "docs",
                        "name": "Documentation",
                        "description": "The guide to each function.",
                        "url": "https://example.com/docs",
                        "state": "",
                        "hasstate": false,
                        "icon": "fa-book"
                    }
                ]
            }
        ]
    }
}}
<div class="local-playergames-administration pg-administration">
    <h2 class="h4 mb-2">{{str_title}}</h2>
    <p class="text-muted">{{str_intro}}</p>

    {{#groups}}
    <section class="pg-admin-group pg-admin-group-{{key}}" aria-labelledby="pg-admin-group-{{key}}">
        <h3 class="h5" id="pg-admin-group-{{key}}">{{title}}</h3>
        <div class="pg-admin-grid">
            {{#cards}}
            <a class="pg-admin-card" href="{{url}}" target="_blank" rel="noopener">
                <span class="pg-admin-card-head">
                    <span class="pg-admin-card-icon" aria-hidden="true"><i class="fa {{icon}}"></i></span>
                    <span class="pg-admin-card-name">{{name}}</span>
                    <i class="fa fa-arrow-up-right-from-square pg-admin-card-newtab" aria-hidden="true"></i>
                    <span class="visually-hidden">{{#str}} opensinnewwindow {{/str}}</span>
                </span>
                <span class="pg-admin-card-desc">{{description}}</span>
                {{#hasstate}}
                <span class="badge pg-admin-card-state">{{state}}</span>
                {{/hasstate}}
            </a>
            {{/cards}}
        </div>
    </section>
    {{/groups}}
</div>
