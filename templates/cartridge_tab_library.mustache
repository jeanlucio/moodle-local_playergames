{{!
    @template local_playergames/cartridge_tab_library

    Library tab: lists all cartridges (concept and quiz types) as cartridge cards.

    Example context (json):
    {
        "action_url": "/local/playergames/cartridge.php",
        "sesskey": "abc123",
        "cartridges": [
            {
                "id": 1,
                "name": "Gamification Fundamentals",
                "language": "en",
                "items_count": 42,
                "is_quiz": false,
                "is_concept": true,
                "is_active": true,
                "is_inactive": false,
                "created_date": "27 Apr 2026, 10:00",
                "modified_date": "27 Apr 2026, 12:00",
                "author": "Jean Lúcio",
                "uploadedby_fullname": "Admin User",
                "edit_url": "/local/playergames/cartridge.php?tab=editor&cartridgeid=1",
                "export_url": "/local/playergames/cartridge.php?action=export_cartridge&cartridgeid=1",
                "sesskey": "abc123"
            }
        ],
        "cartridges_empty": false,
        "url_tab_import": "/local/playergames/cartridge.php?tab=import",
        "url_tab_ai": "/local/playergames/cartridge.php?tab=ai",
        "url_tab_create": "/local/playergames/cartridge.php?tab=create"
    }
}}
<div class="pg-tab-library">

    {{#cartridges_empty}}
    <div class="card shadow-sm">
        <div class="card-body text-center py-5">
            <i class="fa fa-inbox fa-3x text-muted mb-3" aria-hidden="true"></i>
            <p class="text-muted mb-3">{{#str}}cartridge_list_empty, local_playergames{{/str}}</p>
            <div class="d-flex justify-content-center flex-wrap pg-gap-2">
                <a href="{{url_tab_import}}" class="btn btn-outline-primary">
                    <i class="fa fa-upload me-1" aria-hidden="true"></i>
                    {{#str}}cartridge_tab_import, local_playergames{{/str}}
                </a>
                <a href="{{url_tab_ai}}" class="btn btn-outline-primary">
                    <i class="fa fa-magic me-1" aria-hidden="true"></i>
                    {{#str}}cartridge_tab_ai, local_playergames{{/str}}
                </a>
                <a href="{{url_tab_create}}" class="btn btn-primary">
                    <i class="fa fa-plus-circle me-1" aria-hidden="true"></i>
                    {{#str}}cartridge_new_create, local_playergames{{/str}}
                </a>
            </div>
        </div>
    </div>
    {{/cartridges_empty}}

    {{^cartridges_empty}}
    <div class="pg-cartridges-grid">
        {{#cartridges}}
        <div class="pg-cart-card{{#is_concept}} pg-cart-concept{{/is_concept}}{{#is_quiz}} pg-cart-quiz{{/is_quiz}}{{#is_inactive}} pg-cart-inactive{{/is_inactive}}">

            <div class="pg-cart-slot" aria-hidden="true">
                <div class="pg-cart-slot-inner"></div>
            </div>

            <div class="pg-cart-label">
                <div class="pg-cart-label-banner" aria-hidden="true"></div>
                <div class="pg-cart-label-content">
                    <div class="pg-cart-badges">
                        {{#is_concept}}
                        <span class="pg-cart-badge pg-cart-badge-concept">
                            {{#str}}cartridge_type_concept, local_playergames{{/str}}
                        </span>
                        {{/is_concept}}
                        {{#is_quiz}}
                        <span class="pg-cart-badge pg-cart-badge-quiz">
                            {{#str}}cartridge_type_quiz, local_playergames{{/str}}
                        </span>
                        {{/is_quiz}}
                        {{#is_active}}
                        <span class="pg-cart-badge pg-cart-badge-active">
                            {{#str}}cartridge_active, local_playergames{{/str}}
                        </span>
                        {{/is_active}}
                        {{#is_inactive}}
                        <span class="pg-cart-badge pg-cart-badge-inactive">
                            {{#str}}cartridge_inactive, local_playergames{{/str}}
                        </span>
                        {{/is_inactive}}
                    </div>

                    <div class="pg-cart-title">{{name}}</div>

                    <div class="pg-cart-meta">
                        <div class="pg-cart-meta-row">
                            <i class="fa fa-th-list" aria-hidden="true"></i>
                            <span>{{items_count}}</span>
                        </div>
                        {{#language}}
                        <div class="pg-cart-meta-row">
                            <i class="fa fa-globe" aria-hidden="true"></i>
                            <span>{{language}}</span>
                        </div>
                        {{/language}}
                        <div class="pg-cart-meta-row">
                            <i class="fa fa-calendar" aria-hidden="true"></i>
                            <span>{{created_date}}</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="pg-cart-footer">
                <i class="fa fa-user" aria-hidden="true"></i>
                <span class="pg-cart-author" title="{{uploadedby_fullname}}">{{uploadedby_fullname}}</span>
            </div>

            <div class="pg-cart-actions">
                {{#is_concept}}
                <a href="{{edit_url}}"
                   class="btn btn-sm pg-cart-btn-action"
                   aria-label="{{#str}}cartridge_edit_concepts, local_playergames{{/str}}"
                   title="{{#str}}cartridge_edit_concepts, local_playergames{{/str}}">
                    <i class="fa fa-pencil" aria-hidden="true"></i>
                </a>
                {{/is_concept}}
                {{#is_quiz}}
                <a href="{{edit_url}}"
                   class="btn btn-sm pg-cart-btn-action"
                   aria-label="{{#str}}cartridge_edit_questions, local_playergames{{/str}}"
                   title="{{#str}}cartridge_edit_questions, local_playergames{{/str}}">
                    <i class="fa fa-pencil" aria-hidden="true"></i>
                </a>
                {{/is_quiz}}
                <a href="{{export_url}}"
                   class="btn btn-sm pg-cart-btn-action"
                   aria-label="{{#str}}cartridge_export, local_playergames{{/str}}"
                   title="{{#str}}cartridge_export, local_playergames{{/str}}">
                    <i class="fa fa-download" aria-hidden="true"></i>
                </a>
                <form method="post" action="{{action_url}}" class="d-inline">
                    <input type="hidden" name="sesskey" value="{{sesskey}}">
                    <input type="hidden" name="action" value="toggle_active">
                    <input type="hidden" name="cartridgeid" value="{{id}}">
                    {{#is_active}}
                    <button type="submit"
                            class="btn btn-sm pg-cart-btn-action pg-cart-btn-warning"
                            aria-label="{{#str}}cartridge_deactivate, local_playergames{{/str}}"
                            title="{{#str}}cartridge_deactivate, local_playergames{{/str}}">
                        <i class="fa fa-pause" aria-hidden="true"></i>
                    </button>
                    {{/is_active}}
                    {{#is_inactive}}
                    <button type="submit"
                            class="btn btn-sm pg-cart-btn-action pg-cart-btn-success"
                            aria-label="{{#str}}cartridge_activate, local_playergames{{/str}}"
                            title="{{#str}}cartridge_activate, local_playergames{{/str}}">
                        <i class="fa fa-play" aria-hidden="true"></i>
                    </button>
                    {{/is_inactive}}
                </form>
                <form method="post" action="{{action_url}}" class="d-inline"
                      data-pg-confirm="{{#str}}cartridge_confirm_delete, local_playergames{{/str}}">
                    <input type="hidden" name="sesskey" value="{{sesskey}}">
                    <input type="hidden" name="action" value="delete_cartridge">
                    <input type="hidden" name="cartridgeid" value="{{id}}">
                    <button type="submit"
                            class="btn btn-sm pg-cart-btn-action pg-cart-btn-danger"
                            aria-label="{{#str}}cartridge_delete, local_playergames{{/str}}">
                        <i class="fa fa-trash" aria-hidden="true"></i>
                    </button>
                </form>
            </div>

            <div class="pg-cart-pins" aria-hidden="true"></div>
        </div>
        {{/cartridges}}
    </div>
    {{/cartridges_empty}}

</div>{{! .pg-tab-library }}
