{{!
    @template local_playergames/help_modal

    Hidden source for the "how PlayerGames works" explanation, moved into a
    core/modal on first open by amd/src/help_modal.js. Static content, no
    per-render data — shared by nav_header.mustache (every PlayerGames page)
    and, later, block_playergames's widget.mustache.

    @package local_playergames
    @copyright 2026 Jean Lúcio
    @license https://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later

    Example context (json):
    {
        "str_section_season_xp_title": "Season XP",
        "str_section_season_xp_body": "Earned by playing daily games and checking in.",
        "str_section_learning_xp_title": "Learning XP",
        "str_section_learning_xp_body": "Mirrors your course activity from PlayerHUD.",
        "str_section_avatars_title": "Avatars",
        "str_section_avatars_body": "Unlocked permanently as you reach higher levels.",
        "str_section_rankings_title": "Rankings",
        "str_section_rankings_body": "Appearing in a ranking is optional."
    }
}}
<div id="pg-help-content" hidden>
    <h5>{{str_section_season_xp_title}}</h5>
    <p>{{str_section_season_xp_body}}</p>

    <h5>{{str_section_learning_xp_title}}</h5>
    <p>{{str_section_learning_xp_body}}</p>

    <h5>{{str_section_avatars_title}}</h5>
    <p>{{str_section_avatars_body}}</p>

    <h5>{{str_section_rankings_title}}</h5>
    <p class="mb-0">{{str_section_rankings_body}}</p>
</div>
