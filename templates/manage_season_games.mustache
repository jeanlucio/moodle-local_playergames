{{!
    @template local_playergames/manage_season_games

    Per-season game configuration: enable/disable games and choose the cartridges they draw from.

    Example context (json):
    {
        "seasonname": "Season 1",
        "formaction": "/local/playergames/manage_season_games.php?seasonid=1",
        "sesskey": "abc123",
        "backurl": "/local/playergames/manage_seasons.php",
        "str_back": "Back to seasons",
        "str_enabled": "Enabled",
        "str_cartridges": "Cartridges",
        "str_cartridges_all": "All active cartridges",
        "str_inactive": "Inactive",
        "str_nocartridges": "No cartridges of this type available.",
        "str_save": "Save changes",
        "str_heading": "Game configuration — Season 1",
        "gamerows": [
            {
                "gametype": "quiz",
                "gamename": "PlayerQuiz",
                "family": "quiz",
                "enabled": true,
                "cartridges": [
                    {"id": 1, "name": "Biology Q1 2026", "checked": true}
                ],
                "nocartridges": false,
                "wordrule": "",
                "fewwords": ""
            },
            {
                "gametype": "guess",
                "gamename": "PlayerGuess",
                "family": "concept",
                "enabled": true,
                "cartridges": [
                    {"id": 2, "name": "History", "checked": true, "words": "0 of 20 words fit this game", "inactive": false}
                ],
                "nocartridges": false,
                "wordrule": "Words that fit: a single word, only letters, from 4 to 8 letters.",
                "fewwords": "Words that fit in the chosen cartridges: 0. This game needs at least 1."
            }
        ]
    }
}}
<div class="local-playergames-season-games">

    <div class="d-flex align-items-center mb-4">
        <a href="{{backurl}}" class="btn btn-outline-secondary btn-sm me-3">
            <i class="fa fa-arrow-left me-1" aria-hidden="true"></i>
            {{str_back}}
        </a>
        <h2 class="mb-0">{{str_heading}}</h2>
    </div>

    <form method="post" action="{{formaction}}">
        <input type="hidden" name="sesskey" value="{{sesskey}}">

        {{#gamerows}}
        <div class="card mb-3">
            <div class="card-header d-flex align-items-center">
                <div class="form-check form-switch me-3 mb-0">
                    <input class="form-check-input"
                           type="checkbox"
                           role="switch"
                           id="pg-enabled-{{gametype}}"
                           name="enabled_{{gametype}}"
                           value="1"
                           {{#enabled}}checked{{/enabled}}
                           aria-label="{{gamename}} — {{str_enabled}}">
                </div>
                <h3 class="h5 mb-0">{{gamename}}</h3>
            </div>
            <div class="card-body">
                <div class="row g-4">

                    {{! Cartridge selection }}
                    <div class="col-12">
                        <fieldset>
                            <legend class="h6 fw-semibold">{{str_cartridges}}</legend>
                            {{#nocartridges}}
                            <p class="text-muted small">{{str_nocartridges}}</p>
                            {{/nocartridges}}
                            {{^nocartridges}}
                            <p class="text-muted small mb-2">{{str_cartridges_all}}</p>
                            {{#wordrule}}
                            <p class="small mb-2">{{wordrule}}</p>
                            {{/wordrule}}
                            {{#fewwords}}
                            <div class="alert alert-warning py-2" role="alert">
                                <i class="fa fa-triangle-exclamation me-2" aria-hidden="true"></i>{{fewwords}}
                            </div>
                            {{/fewwords}}
                            {{#cartridges}}
                            <div class="form-check">
                                <input class="form-check-input"
                                       type="checkbox"
                                       name="cartridges_{{gametype}}[]"
                                       id="pg-cart-{{gametype}}-{{id}}"
                                       value="{{id}}"
                                       {{#checked}}checked{{/checked}}>
                                <label class="form-check-label"
                                       for="pg-cart-{{gametype}}-{{id}}">
                                    {{name}}
                                    {{#inactive}}<span class="badge bg-secondary">{{str_inactive}}</span>{{/inactive}}
                                    {{#words}}<small class="d-block">{{words}}</small>{{/words}}
                                </label>
                            </div>
                            {{/cartridges}}
                            {{/nocartridges}}
                        </fieldset>
                    </div>

                </div>
            </div>
        </div>
        {{/gamerows}}

        <div class="mt-3">
            <button type="submit" class="btn btn-primary">
                <i class="fa fa-save me-1" aria-hidden="true"></i>
                {{str_save}}
            </button>
            <a href="{{backurl}}" class="btn btn-outline-secondary ms-2">
                {{str_back}}
            </a>
        </div>

    </form>

</div>
