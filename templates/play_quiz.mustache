{{!
    @template local_playergames/play_quiz

    Daily PlayerQuiz game — one question at a time; wrong answer loads next concept.

    Example context (json):
    {
        "sesskey": "abc123",
        "formaction": "/local/playergames/play_quiz.php",
        "already_played": false,
        "cooldown_active": false,
        "no_questions": false,
        "question_seconds": 120,
        "max_attempts": 0,
        "huburl": "/local/playergames/hub.php",
        "str_already_played": "You have already played PlayerQuiz today.",
        "str_locked": "PlayerQuiz is on cooldown",
        "str_locked_msg": "PlayerQuiz will be available again in 2 mins.",
        "str_no_questions": "No questions available.",
        "str_completed": "Correct!",
        "str_attempt": "Attempt",
        "str_time_left": "Time left",
        "str_failed": "Out of attempts",
        "str_failed_msg": "You ran out of attempts. Head back to the Hub and try again.",
        "str_result_xp": "XP earned:",
        "str_back_to_hub": "Back to Hub",
        "questions": [
            {
                "index": 1,
                "source": "cartridge",
                "sourceid": 42,
                "questiontext": "What is photosynthesis?",
                "answers": [
                    {"letter": "A", "text": "A process converting light into sugar.", "correct": true},
                    {"letter": "B", "text": "A method of cell division.", "correct": false},
                    {"letter": "C", "text": "A type of fungal reproduction.", "correct": false},
                    {"letter": "D", "text": "The breakdown of starch by saliva.", "correct": false},
                    {"letter": "E", "text": "A form of animal digestion.", "correct": false}
                ]
            }
        ]
    }
}}
<div class="local-playergames-play-quiz pg-play-quiz-wrap container py-4">

    {{#already_played}}
    <div class="alert alert-info" role="alert">
        <i class="fa fa-check-circle me-2" aria-hidden="true"></i>
        {{str_already_played}}
        <div class="mt-3">
            <a href="{{huburl}}" class="btn btn-primary btn-sm">{{str_back_to_hub}}</a>
        </div>
    </div>
    {{/already_played}}

    {{#cooldown_active}}
    <div class="alert alert-warning" role="alert">
        <i class="fa fa-hourglass-half me-2" aria-hidden="true"></i>
        <strong>{{str_locked}}</strong>
        <div class="mt-1">{{str_locked_msg}}</div>
        <div class="mt-3">
            <a href="{{huburl}}" class="btn btn-primary btn-sm">{{str_back_to_hub}}</a>
        </div>
    </div>
    {{/cooldown_active}}

    {{#no_questions}}
    <div class="alert alert-warning" role="alert">
        <i class="fa fa-exclamation-triangle me-2" aria-hidden="true"></i>
        {{str_no_questions}}
    </div>
    {{/no_questions}}

    {{^already_played}}{{^cooldown_active}}{{^no_questions}}
    <div id="pg-quiz-container"
         data-action="{{formaction}}"
         data-sesskey="{{sesskey}}"
         data-question-seconds="{{question_seconds}}"
         data-max-attempts="{{max_attempts}}"
         data-str-attempt="{{str_attempt}}">

        <div class="mb-4 d-flex align-items-center justify-content-between">
            <div id="pg-quiz-progress-text" class="text-muted small mb-1">&nbsp;</div>
            <div id="pg-quiz-timer" class="badge pg-quiz-timer d-none"
                 role="timer" aria-label="{{str_time_left}}">&nbsp;</div>
        </div>

        {{#questions}}
        <div class="pg-quiz-question d-none" data-index="{{index}}"
             data-source="{{source}}" data-source-id="{{sourceid}}">
            <p class="fs-5 fw-semibold mb-4">{{{questiontext}}}</p>
            <div class="d-grid gap-2">
                {{#answers}}
                <button type="button"
                        class="pg-quiz-answer btn btn-outline-primary text-start"
                        data-correct="{{#correct}}1{{/correct}}{{^correct}}0{{/correct}}">
                    <span class="pg-answer-letter fw-bold me-2">{{letter}}.</span>
                    {{{text}}}
                </button>
                {{/answers}}
            </div>
        </div>
        {{/questions}}

        <div id="pg-quiz-result" class="d-none">
            <div class="card border-0 shadow-sm text-center p-4">
                <h3 class="mb-3">
                    <i class="fa fa-star text-warning me-2" aria-hidden="true"></i>
                    {{str_completed}}
                </h3>
                <p class="text-success fw-bold fs-4">
                    {{str_result_xp}} <span id="pg-quiz-xp-count">…</span>
                </p>
                <a href="{{huburl}}" class="btn btn-primary mt-3">{{str_back_to_hub}}</a>
            </div>
        </div>

        <div id="pg-quiz-failed" class="d-none">
            <div class="card border-0 shadow-sm text-center p-4">
                <h3 class="mb-3">
                    <i class="fa fa-circle-xmark text-danger me-2" aria-hidden="true"></i>
                    {{str_failed}}
                </h3>
                <p class="text-muted">{{str_failed_msg}}</p>
                <a href="{{huburl}}" class="btn btn-primary mt-3">{{str_back_to_hub}}</a>
            </div>
        </div>

    </div>
    {{/no_questions}}{{/cooldown_active}}{{/already_played}}

</div>
