{{!
    @template local_playergames/help_trigger_button

    Icon-only button that opens the "how PlayerGames works" modal (see
    help_modal.mustache). Shared by nav_header.mustache (every PlayerGames
    page) and, later, block_playergames's widget.mustache; wired by
    amd/src/help_modal.js, which looks up this exact markup by selector.

    @package local_playergames
    @copyright 2026 Jean Lúcio
    @license https://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later

    Example context (json):
    {
        "str_help_modal_title": "How PlayerGames works",
        "str_help_trigger": "How PlayerGames works"
    }
}}
<button type="button" class="btn btn-outline-secondary btn-sm pg-help-trigger"
    data-help-trigger data-modal-title="{{str_help_modal_title}}"
    aria-label="{{str_help_trigger}}" title="{{str_help_trigger}}">
    <i class="fa fa-question-circle" aria-hidden="true"></i>
</button>
