{{!
    @template local_playergames/dashboard

    Player ecosystem map: the plugins grouped by family. Selecting one draws only its connections and shows, below
    the map, what it uses and what uses it.

    Classes required for JS:
    * pg-eco-card    — plugin card, selected with a click, Enter or Space.
    * pg-eco         — positioning context for the connector overlay.
    * pg-eco-overlay — empty SVG the JS fills with the connectors of the selected card.
    * pg-eco-detail  — the detail of one plugin, shown while its card is selected.
    * pg-eco-hint    — the text shown while no card is selected.

    Data attributes / nodes required for JS:
    * data-component on each card and each detail — plugin frankenstyle component.
    * script#pg-ecosystem-edges   — JSON array of {from, to, type} edges.

    Example context (json):
    {
        "str_legend": "Connections",
        "legend": [
            {"cssclass": "pg-edge-requires", "label": "Direct dependency"},
            {"cssclass": "pg-edge-ai", "label": "Optional AI"},
            {"cssclass": "pg-edge-assoc", "label": "Association"},
            {"cssclass": "pg-edge-planned", "label": "Planned"}
        ],
        "groups": [
            {
                "key": "core",
                "label": "Core",
                "cards": [
                    {
                        "component": "local_playergames",
                        "displayname": "PlayerGames",
                        "abbr": "PG",
                        "color": "#4f46e5",
                        "isinstalled": true,
                        "statuslabel": "Installed",
                        "statusbadge": "pg-badge-success",
                        "version": "v0.1.6",
                        "hasversion": true,
                        "description": "AI and gamification hub.",
                        "usesai": true,
                        "aiusers": ""
                    }
                ]
            }
        ],
        "cards": [
            {
                "component": "local_playergames",
                "displayname": "PlayerGames",
                "abbr": "PG",
                "icon": "fa-gamepad",
                "color": "#4f46e5",
                "isinstalled": true,
                "statuslabel": "Installed",
                "statusbadge": "pg-badge-success",
                "version": "v0.1.6",
                "hasversion": true,
                "description": "AI and gamification hub.",
                "usesai": true,
                "aiusers": "",
                "hasuses": true,
                "uses": [
                    {"typelabel": "Takes AI from", "cssclass": "pg-chip-ai", "names": "AI Hub"}
                ],
                "hasusedby": true,
                "usedby": [
                    {"typelabel": "Required by", "cssclass": "pg-chip-requires", "names": "PlayerGames block"}
                ]
            }
        ],
        "edgesjson": "[{\"from\":\"block_playerhud\",\"to\":\"local_playergames\",\"type\":\"ai\"}]"
    }
}}
<div class="local-playergames-dashboard">

    <ul class="pg-eco-legend list-unstyled d-flex flex-wrap mb-3 pg-gap-3" aria-label="{{str_legend}}">
        {{#legend}}
        <li class="pg-eco-legend-item">
            <span class="pg-eco-legend-swatch {{cssclass}}" aria-hidden="true"></span>
            <span class="small">{{label}}</span>
        </li>
        {{/legend}}
    </ul>

    <div class="pg-eco">
        <svg class="pg-eco-overlay" aria-hidden="true" focusable="false"></svg>
        <div class="pg-eco-groups">
            {{#groups}}
            <section class="pg-eco-group pg-eco-group-{{key}}" aria-label="{{label}}">
                <h2 class="pg-eco-group-title">{{label}}</h2>
                <div class="pg-eco-group-cards">
                    {{#cards}}
                    <div class="pg-eco-card{{^isinstalled}} pg-eco-card-missing{{/isinstalled}}"
                         data-component="{{component}}"
                         role="button"
                         tabindex="0"
                         aria-pressed="false"
                         aria-label="{{displayname}}, {{statuslabel}}">
                        <div class="pg-eco-card-head">
                            <span class="pg-eco-badge">
                                <svg class="pg-eco-badge-circle" viewBox="0 0 40 40"
                                     aria-hidden="true" focusable="false">
                                    <circle cx="20" cy="20" r="20" fill="{{color}}"/>
                                </svg>
                                <i class="fa {{icon}} pg-eco-badge-icon" aria-hidden="true"></i>
                            </span>
                            <div class="pg-eco-card-titles">
                                <span class="pg-eco-card-name">{{displayname}}</span>
                                <span class="badge {{statusbadge}} pg-eco-status">{{statuslabel}}</span>
                            </div>
                            {{#usesai}}
                            <span class="pg-eco-chip pg-chip-ai pg-eco-card-mark"
                                  title="{{#str}}dashboard_ai_chip_title, local_playergames{{/str}}">
                                {{#str}}dashboard_ai_chip, local_playergames{{/str}}
                            </span>
                            {{/usesai}}
                            {{#aiusers}}
                            <span class="pg-eco-chip pg-eco-card-mark pg-eco-chip-count">{{aiusers}}</span>
                            {{/aiusers}}
                        </div>
                    </div>
                    {{/cards}}
                </div>
            </section>
            {{/groups}}
        </div>
    </div>

    <section class="pg-eco-panel mt-4" aria-live="polite">
        <p class="pg-eco-hint mb-0">{{#str}}dashboard_detail_hint, local_playergames{{/str}}</p>
        {{#cards}}
        <div class="pg-eco-detail" data-component="{{component}}" hidden>
            <h2 class="h5 mb-1">{{displayname}}</h2>
            <p class="mb-2">{{description}}</p>
            <p class="mb-3">
                <span class="badge {{statusbadge}}">{{statuslabel}}</span>
                {{#hasversion}}<small class="ms-2">{{version}}</small>{{/hasversion}}
            </p>
            <div class="pg-eco-detail-rels">
                <div>
                    <h3 class="pg-eco-detail-title">{{#str}}dashboard_uses, local_playergames{{/str}}</h3>
                    {{#hasuses}}
                    <ul class="list-unstyled mb-0">
                        {{#uses}}
                        <li class="mb-2 d-flex align-items-start pg-gap-2">
                            <span class="pg-eco-chip {{cssclass}}">{{typelabel}}</span>
                            <span>{{names}}</span>
                        </li>
                        {{/uses}}
                    </ul>
                    {{/hasuses}}
                    {{^hasuses}}<p class="mb-0">{{#str}}dashboard_none, local_playergames{{/str}}</p>{{/hasuses}}
                </div>
                <div>
                    <h3 class="pg-eco-detail-title">{{#str}}dashboard_usedby, local_playergames{{/str}}</h3>
                    {{#hasusedby}}
                    <ul class="list-unstyled mb-0">
                        {{#usedby}}
                        <li class="mb-2 d-flex align-items-start pg-gap-2">
                            <span class="pg-eco-chip {{cssclass}}">{{typelabel}}</span>
                            <span>{{names}}</span>
                        </li>
                        {{/usedby}}
                    </ul>
                    {{/hasusedby}}
                    {{^hasusedby}}<p class="mb-0">{{#str}}dashboard_none, local_playergames{{/str}}</p>{{/hasusedby}}
                </div>
            </div>
        </div>
        {{/cards}}
    </section>

</div>

<script type="application/json" id="pg-ecosystem-edges">{{{edgesjson}}}</script>
