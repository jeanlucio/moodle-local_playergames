{{!
    @template local_playergames/dashboard

    Player ecosystem dashboard: quick-access cards and a grouped, clickable
    plugin map whose typed relations are drawn as connector lines by JS.

    Classes required for JS:
    * pg-eco-card    — clickable plugin card (click/Enter/Space opens modal).
    * pg-eco         — positioning context for the connector overlay.
    * pg-eco-overlay — empty SVG the JS fills with connector paths.

    Data attributes / nodes required for JS:
    * data-component on each card — plugin frankenstyle component.
    * script#pg-ecosystem-edges   — JSON array of {from, to, type} edges.

    Example context (json):
    {
        "str_heading_ecosystem": "Plugin map",
        "str_legend": "Connections",
        "legend": [
            {"cssclass": "pg-edge-requires", "label": "Direct dependency"},
            {"cssclass": "pg-edge-ai", "label": "Optional AI"},
            {"cssclass": "pg-edge-assoc", "label": "Association"},
            {"cssclass": "pg-edge-planned", "label": "Planned"}
        ],
        "groups": [
            {
                "key": "core",
                "label": "Core",
                "cards": [
                    {
                        "component": "local_playergames",
                        "displayname": "PlayerGames",
                        "abbr": "PG",
                        "color": "#4f46e5",
                        "isinstalled": true,
                        "statuslabel": "Installed",
                        "statusbadge": "bg-success",
                        "version": "0.1.6",
                        "hasversion": true,
                        "description": "AI and gamification hub.",
                        "hasconnections": true,
                        "connectiongroups": [
                            {"typelabel": "Optional AI", "cssclass": "pg-chip-ai", "names": "Player HUD"}
                        ]
                    }
                ]
            }
        ],
        "cards": [
            {
                "component": "local_playergames",
                "displayname": "PlayerGames",
                "abbr": "PG",
                "icon": "fa-gamepad",
                "color": "#4f46e5",
                "isinstalled": true,
                "statuslabel": "Installed",
                "statusbadge": "bg-success",
                "version": "0.1.6",
                "hasversion": true,
                "description": "AI and gamification hub.",
                "hasconnections": true,
                "connectiongroups": [
                    {"typelabel": "Optional AI", "cssclass": "pg-chip-ai", "names": "Player HUD"}
                ]
            }
        ],
        "edgesjson": "[{\"from\":\"block_playerhud\",\"to\":\"local_playergames\",\"type\":\"ai\"}]"
    }
}}
<div class="local-playergames-dashboard">

    <div class="d-flex flex-wrap align-items-center justify-content-between mb-3 pg-gap-2">
        <h2 class="h5 mb-0">{{str_heading_ecosystem}}</h2>
        <ul class="pg-eco-legend list-unstyled d-flex flex-wrap mb-0 pg-gap-3" aria-label="{{str_legend}}">
            {{#legend}}
            <li class="pg-eco-legend-item">
                <span class="pg-eco-legend-swatch {{cssclass}}" aria-hidden="true"></span>
                <span class="small">{{label}}</span>
            </li>
            {{/legend}}
        </ul>
    </div>

    <div class="pg-eco">
        <svg class="pg-eco-overlay" aria-hidden="true" focusable="false"></svg>
        <div class="pg-eco-groups">
            {{#groups}}
            <section class="pg-eco-group pg-eco-group-{{key}}" aria-label="{{label}}">
                <h3 class="pg-eco-group-title">{{label}}</h3>
                <div class="pg-eco-group-cards">
                    {{#cards}}
                    <div class="pg-eco-card{{^isinstalled}} pg-eco-card-missing{{/isinstalled}}"
                         data-component="{{component}}"
                         role="button"
                         tabindex="0"
                         aria-label="{{displayname}}, {{statuslabel}}">
                        <div class="pg-eco-card-head">
                            <span class="pg-eco-badge">
                                <svg class="pg-eco-badge-circle" viewBox="0 0 40 40"
                                     aria-hidden="true" focusable="false">
                                    <circle cx="20" cy="20" r="20" fill="{{color}}"/>
                                </svg>
                                <i class="fa {{icon}} pg-eco-badge-icon" aria-hidden="true"></i>
                            </span>
                            <div class="pg-eco-card-titles">
                                <span class="pg-eco-card-name">{{displayname}}</span>
                                <span class="badge {{statusbadge}} pg-eco-status">{{statuslabel}}</span>
                            </div>
                            <i class="fa fa-arrow-right pg-eco-card-go" aria-hidden="true"></i>
                        </div>
                    </div>
                    {{/cards}}
                </div>
            </section>
            {{/groups}}
        </div>
    </div>

</div>

{{! Hidden modal content blocks — one per plugin, read by dashboard.js }}
{{#cards}}
<div id="pg-modal-{{component}}" class="d-none">
    <p class="mb-2">{{description}}</p>
    <p class="mb-0">
        <span class="badge {{statusbadge}}">{{statuslabel}}</span>
        {{#hasversion}}<small class="text-muted ms-2">v{{version}}</small>{{/hasversion}}
    </p>
    {{#hasconnections}}
    <hr class="my-3">
    <ul class="list-unstyled mb-0">
        {{#connectiongroups}}
        <li class="mb-2 d-flex align-items-start pg-gap-2">
            <span class="pg-eco-chip {{cssclass}}">{{typelabel}}</span>
            <span>{{names}}</span>
        </li>
        {{/connectiongroups}}
    </ul>
    {{/hasconnections}}
</div>
{{/cards}}

<script type="application/json" id="pg-ecosystem-edges">{{{edgesjson}}}</script>
