{{!
    @template local_playergames/reset_data

    The page that deletes all the PlayerGames data: what goes, with how much of it there is, what stays, and the
    word to type before anything is deleted.

    Example context (json):
    {
        "formaction": "/local/playergames/reset_data.php",
        "sesskey": "abc123",
        "groups": [
            {"name": "Seasons, with their game settings", "count": 3},
            {"name": "Streaks, freezes, achievements and avatar progress", "count": 120}
        ],
        "hasdata": true,
        "confirmword": "RESET",
        "backurl": "/local/playergames/administration.php"
    }
}}
<div class="pg-reset-data">
    <div class="alert alert-warning" role="alert">
        <i class="fa fa-triangle-exclamation me-2" aria-hidden="true"></i>
        {{#str}} reset_intro, local_playergames {{/str}}
    </div>

    <h2 class="h5 mt-4">{{#str}} reset_deleted_heading, local_playergames {{/str}}</h2>
    <table class="table table-sm pg-reset-table">
        <thead>
            <tr>
                <th scope="col">{{#str}} reset_col_data, local_playergames {{/str}}</th>
                <th scope="col" class="text-end">{{#str}} reset_col_records, local_playergames {{/str}}</th>
            </tr>
        </thead>
        <tbody>
            {{#groups}}
            <tr>
                <td>{{name}}</td>
                <td class="text-end">{{count}}</td>
            </tr>
            {{/groups}}
        </tbody>
    </table>

    <h2 class="h5 mt-4">{{#str}} reset_kept_heading, local_playergames {{/str}}</h2>
    <p>{{#str}} reset_kept_list, local_playergames {{/str}}</p>

    {{#hasdata}}
    <form method="post" action="{{formaction}}" class="mt-4">
        <input type="hidden" name="sesskey" value="{{sesskey}}">
        <label for="pg-reset-word" class="form-label">
            {{#str}} reset_confirm_label, local_playergames, {{confirmword}} {{/str}}
        </label>
        <div class="pg-reset-confirm">
            <input type="text" id="pg-reset-word" name="confirmword" class="form-control" autocomplete="off" required>
            <button type="submit" class="btn btn-danger">{{#str}} reset_submit, local_playergames {{/str}}</button>
        </div>
    </form>
    {{/hasdata}}
    {{^hasdata}}
    <div class="alert alert-info" role="status">{{#str}} reset_empty, local_playergames {{/str}}</div>
    {{/hasdata}}

    <p class="mt-4"><a href="{{backurl}}">{{#str}} reset_back, local_playergames {{/str}}</a></p>
</div>
