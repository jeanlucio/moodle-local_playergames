{{!
    @template local_playergames/past_seasons

    @package local_playergames
    @copyright 2026 Jean Lúcio
    @license https://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later

    Example context (json):
    {
        "str_heading": "Previous seasons",
        "str_col_season": "Season",
        "str_col_xp": "Final XP",
        "str_col_level": "Final level",
        "str_col_missions": "Missions",
        "str_col_rank": "Position",
        "str_col_hall": "Hall of fame",
        "actionurl": "https://example.com/local/playergames/history.php",
        "sesskey": "abc123",
        "hasseasons": true,
        "seasons": [
            {
                "name": "Season 1",
                "level": 7,
                "xp": 1450,
                "missions": 12,
                "seasonid": 1,
                "ranked": true,
                "rank": "3 of 120",
                "hallstatus": "Visible",
                "hallnext": 0,
                "halltext": "Hide my name",
                "halllabel": "Hide my name from the hall of fame, Season 1"
            }
        ]
    }
}}
{{#hasseasons}}
<div class="pg-past-seasons mb-4">
    <h2 class="h4">{{str_heading}}</h2>
    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th scope="col">{{str_col_season}}</th>
                    <th scope="col">{{str_col_xp}}</th>
                    <th scope="col">{{str_col_level}}</th>
                    <th scope="col">{{str_col_missions}}</th>
                    <th scope="col">{{str_col_rank}}</th>
                    <th scope="col">{{str_col_hall}}</th>
                </tr>
            </thead>
            <tbody>
                {{#seasons}}
                <tr>
                    <th scope="row">{{name}}</th>
                    <td>{{xp}}</td>
                    <td>{{level}}</td>
                    <td>{{missions}}</td>
                    <td>{{rank}}</td>
                    <td>
                        {{#ranked}}
                        <form method="post" action="{{actionurl}}" class="d-flex align-items-center flex-wrap pg-hall-switch">
                            <input type="hidden" name="sesskey" value="{{sesskey}}">
                            <input type="hidden" name="action" value="hall">
                            <input type="hidden" name="seasonid" value="{{seasonid}}">
                            <input type="hidden" name="show" value="{{hallnext}}">
                            <span class="me-2">{{hallstatus}}</span>
                            <button type="submit" class="btn btn-sm btn-outline-secondary" aria-label="{{halllabel}}">
                                {{halltext}}
                            </button>
                        </form>
                        {{/ranked}}
                    </td>
                </tr>
                {{/seasons}}
            </tbody>
        </table>
    </div>
</div>
{{/hasseasons}}
